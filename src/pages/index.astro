---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FounderSpotlight from '~/components/widgets/FounderSpotlight.astro';
import LogoMarquee from '~/components/LogoMarquee.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CaseStudy from '~/components/widgets/CaseStudy.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

import { headerData } from '~/navigation';

import samirDeskImage from '~/assets/images/Samir Abid - desk1.png'; // New hero image of Samir Abid at his desk
import sailBoatImage from '~/assets/images/sail-boat-into-sunset-horizon-bottom.jpg'; // New sailboat hero image

// Import testimonial images
import tomRobertsImage from '~/assets/images/people_images/Tom_Roberts.png';
import angusLemonImage from '~/assets/images/people_images/Angus_Lemon.png';

import type { CallToAction as CallToActionType } from '~/types';

// Define Metadata
const metadata = {
  title: 'Pace Insights | Turn Your Expertise into AI-Enabled Products',
  description:
    'Pace Insights partners with expert-led professional services firms to turn proprietary knowledge, judgement and data into AI-enabled intelligence products and services.',
};

// Define actions with proper type annotations
const heroActions = [
  {
    text: 'Book a Discovery Call',
    href: 'https://tidycal.com/yourdatadriven/discovery-call',
    variant: 'primary' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    text: 'Learn More',
    href: '#examples',
    variant: 'secondary' as const,
  },
] satisfies CallToActionType[];
---

<Layout metadata={metadata}>
  <!-- Header Widget -->
  <Fragment slot="header">
    <Header links={headerData.links} actions={headerData.actions} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero Section -->
  <Hero2
    tagline="AI Partner"
    actions={heroActions}
    image={{
      src: sailBoatImage,
      alt: 'Sailing boat navigating towards the horizon at sunset — symbolizing clarity and direction in AI product strategy',
    }}
  >
    <Fragment slot="title">
      Your knowledge has always been your value.
      <span class="text-primary dark:text-white highlight"> Now it can help you grow.</span>
    </Fragment>
    <Fragment slot="subtitle">
      Your firm is built on expertise your clients trust.
      <br /><br />
      But too much of that value is trapped in people’s heads, reports and one-off advice. It’s hard to capture, hard to
      package, and hard to turn into a scalable asset.
      <br /><br />
      But what if your expertise could create value in ways it never could before?
      <br /><br />
      We partner with expert-led firms to turn their knowledge, judgement and methods into AI-enabled products and services
      — creating new revenue, new client value, and new possibilities for their industry.
    </Fragment>
  </Hero2>

  <!-- Logo Marquee Section -->
  <LogoMarquee label="Trusted by world-class teams - not just for AI." />

  <!-- Scroll cue pointing to the examples section -->
  <div class="flex justify-center -mt-2 md:-mt-4">
    <a
      href="#examples"
      class="group inline-flex flex-col items-center gap-1 text-muted hover:text-primary transition-colors"
      aria-label="See examples of intelligence layers we've built"
    >
      <span class="text-sm font-medium tracking-wide uppercase">See examples</span>
      <Icon name="tabler:chevron-down" class="w-6 h-6 motion-safe:animate-bounce" />
    </a>
  </div>

  <!-- Intelligence Layer Examples Section -->
  <section id="examples" class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-5xl px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default">
      <Headline
        title="2 examples of intelligence layers we've built"
        subtitle="The common shift is that our partners' specialist expertise becomes a working, scalable asset."
      />

      <div class="grid gap-8 md:gap-10">
        <div class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0">
          <CaseStudy
            variant="pipeline"
            tag="1 - Regulatory intelligence"
            title="A regulatory intelligence layer"
            subtitle="for a management consulting firm"
            challenge="Decades of reports and client insight — value that was hard to search, connect and reuse at speed."
            whatChanges="Trusted regulatory insight on demand — the latest position, how it evolved, and the reasoning behind past advice."
          />
        </div>
        <div class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0">
          <CaseStudy
            variant="synthesis"
            tag="2 - Decision support"
            title="A finanical decision-support layer"
            subtitle="for a regulated professional services firm"
            challenge="High-value financial decisions, incomplete information, fast-moving markets. Senior judgement is essential but hard to scale."
            whatChanges="Juniors work with stronger guidance, seniors focus on the highest-value calls, and the firm's expertise applies consistently."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <Testimonials
    testimonials={[
      {
        testimonial:
          'Wow, that Samir sure knows his stuff. And his presentation style is fantastic – his authority around the topic comes through without being condescending.',
        name: 'Tom Roberts',
        job: 'Business Leader',
        image: {
          src: tomRobertsImage,
          alt: 'Tom Roberts',
        },
      },
      {
        testimonial:
          "I loved the approach of focusing on the process of experimentation rather than simply giving us an answer. It's like the saying, 'teach a man to fish.' Great!",
        name: 'Angus Lemon',
        job: 'Team Manager',
        image: {
          src: angusLemonImage,
          alt: 'Angus Lemon',
        },
      },
    ]}
  />

  <!-- Founder Spotlight Section -->
  <FounderSpotlight
    id="founder"
    image={{
      src: samirDeskImage,
      alt: 'Samir Abid - Founder, Pace Insights',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FounderSpotlight>
</Layout>
