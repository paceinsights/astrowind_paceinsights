---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FounderSpotlight from '~/components/widgets/FounderSpotlight.astro';
import LogoMarquee from '~/components/LogoMarquee.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';

import { headerData } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';

import samirRaceEngineerImage from '~/assets/images/Samir Abid standing2.png'; // Updated image import
import aiStrategyImage from '~/assets/images/PaceInsights_AI_Strategy.png'; // Import AI strategy image

// Import testimonial images
import jeffBraunImage from '~/assets/images/people_images/Jeff_Braun.png';
import tomRobertsImage from '~/assets/images/people_images/Tom_Roberts.png';
import angusLemonImage from '~/assets/images/people_images/Angus_Lemon.png';

import type { CallToAction as CallToActionType } from '~/types';

// Define Metadata
const metadata = {
  title: 'Pace Insights | AI Strategy & Implementation for Business Leaders',
  description:
    'Partner with Pace Insights to confidently adopt AI. We build practical AI tools and strategies, moving beyond hype to deliver real business outcomes. Free AI Healthcheck available.',
};

// Define actions with proper type annotations
const heroActions = [
  {
    text: 'Book a Discovery Call',
    href: 'https://tidycal.com/yourdatadriven/discovery-call',
    variant: 'primary' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    text: 'Learn More',
    href: getPermalink('/articles'),
    variant: 'secondary' as const,
  },
] satisfies CallToActionType[];
---

<Layout metadata={metadata}>
  <!-- Header Widget -->
  <Fragment slot="header">
    <Header links={headerData.links} actions={headerData.actions} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero Section -->
  <Hero2
    tagline="Applied AI Partner"
    actions={heroActions}
    image={{
      src: aiStrategyImage,
      alt: 'AI Strategy',
    }}
  >
    <Fragment slot="title">
      If we doubled your budget, <span class="text-primary dark:text-white highlight"
        ><br />where would you invest it?</span
      >
    </Fragment>
    <Fragment slot="subtitle">
      AI has shifted the constraints on how businesses operate.<br />
      Expensive can become cheap.<br />
      Weeks can become hours.<br />
      <br />But just because you <i>can</i>, doesn't mean you <i>should</i>.<br />
      <br />If your current limits on cost, time and people were lifted,
      <br />what would you <i><u>really</u></i> love your business to achieve?<br />
      <br />Now is your time to get a little imaginative...
    </Fragment>
  </Hero2>

  <!-- Logo Marquee Section -->
  <LogoMarquee label="Trusted by world-class teams - not just for AI." />

  <!-- Testimonials Section -->
  <Testimonials
    testimonials={[
      {
        testimonial:
          "Are you kidding me Samir, you're selling this! This ticks all the boxes. It will be a big help. Please just don't tell anyone, I need every advantage I can get!",
        name: 'Jeff Braun',
        job: 'Race Engineer',
        image: {
          src: jeffBraunImage,
          alt: 'Jeff Braun',
        },
      },
      {
        testimonial:
          'Wow, that Samir sure knows his stuff. And his presentation style is fantastic – his authority around the topic comes through without being condescending.',
        name: 'Tom Roberts',
        job: 'Business Leader',
        image: {
          src: tomRobertsImage,
          alt: 'Tom Roberts',
        },
      },
      {
        testimonial:
          "I loved the approach of focusing on the process of experimentation rather than simply giving us an answer. It's like the saying, 'teach a man to fish.' Great!",
        name: 'Angus Lemon',
        job: 'Team Manager',
        image: {
          src: angusLemonImage,
          alt: 'Angus Lemon',
        },
      },
    ]}
  />

  <!-- Founder Spotlight Section -->
  <FounderSpotlight
    image={{
      src: samirRaceEngineerImage,
      alt: 'Samir Abid - Founder, Pace Insights',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FounderSpotlight>
</Layout>
