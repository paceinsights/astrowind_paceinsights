---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FounderSpotlight from '~/components/widgets/FounderSpotlight.astro';
import LogoMarquee from '~/components/LogoMarquee.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';

import { headerData } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';

import samirRaceEngineerImage from '~/assets/images/Samir Abid standing2.png'; // Updated image import
import samirDeskImage from '~/assets/images/Samir Abid - desk1.png'; // New hero image of Samir Abid at his desk

// Import testimonial images
import jeffBraunImage from '~/assets/images/people_images/Jeff_Braun.png';
import tomRobertsImage from '~/assets/images/people_images/Tom_Roberts.png';
import angusLemonImage from '~/assets/images/people_images/Angus_Lemon.png';

import type { CallToAction as CallToActionType } from '~/types';

// Define Metadata
const metadata = {
  title: 'Pace Insights | AI Strategy & Implementation for Business Leaders',
  description:
    'Partner with Pace Insights to confidently adopt AI. We build practical AI tools and strategies, moving beyond hype to deliver real business outcomes. Free AI Healthcheck available.',
};

// Define actions with proper type annotations
const heroActions = [
  {
    text: 'Book a Discovery Call',
    href: 'https://tidycal.com/yourdatadriven/discovery-call',
    variant: 'primary' as const,
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    text: 'Learn More',
    href: getPermalink('/articles'),
    variant: 'secondary' as const,
  },
] satisfies CallToActionType[];
---

<Layout metadata={metadata}>
  <!-- Header Widget -->
  <Fragment slot="header">
    <Header links={headerData.links} actions={headerData.actions} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero Section -->
  <Hero2
    tagline="AI Product Partner"
    actions={heroActions}
    image={{
      src: samirDeskImage,
      alt: 'Samir Abid — Founder, Pace Insights',
    }}
  >
    <Fragment slot="title">
      Your knowledge has always been your value.
      <span class="text-primary dark:text-white highlight"> Now it can be your product.</span>
    </Fragment>
    <Fragment slot="subtitle">
      Your firm is built on expertise your clients pay a premium for.
      <br /><br />
      But most of it lives in people’s heads. It’s hard to scale, hard to package, and hard to turn into an asset.
      <br /><br />
      But what if that knowledge could become a product?
      <br /><br />
      We work with you to shape the right product opportunity, test it with a prototype, and see whether it can become a
      real business we build together.
    </Fragment>
  </Hero2>

  <!-- Logo Marquee Section -->
  <LogoMarquee label="Trusted by world-class teams - not just for AI." />

  <!-- Testimonials Section -->
  <Testimonials
    testimonials={[
      {
        testimonial:
          "Are you kidding me Samir, you're selling this! This ticks all the boxes. It will be a big help. Please just don't tell anyone, I need every advantage I can get!",
        name: 'Jeff Braun',
        job: 'Race Engineer',
        image: {
          src: jeffBraunImage,
          alt: 'Jeff Braun',
        },
      },
      {
        testimonial:
          'Wow, that Samir sure knows his stuff. And his presentation style is fantastic – his authority around the topic comes through without being condescending.',
        name: 'Tom Roberts',
        job: 'Business Leader',
        image: {
          src: tomRobertsImage,
          alt: 'Tom Roberts',
        },
      },
      {
        testimonial:
          "I loved the approach of focusing on the process of experimentation rather than simply giving us an answer. It's like the saying, 'teach a man to fish.' Great!",
        name: 'Angus Lemon',
        job: 'Team Manager',
        image: {
          src: angusLemonImage,
          alt: 'Angus Lemon',
        },
      },
    ]}
  />

  <!-- Founder Spotlight Section -->
  <FounderSpotlight
    image={{
      src: samirRaceEngineerImage,
      alt: 'Samir Abid - Founder, Pace Insights',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FounderSpotlight>
</Layout>
