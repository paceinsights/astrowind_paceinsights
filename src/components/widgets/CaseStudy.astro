---
// CaseStudy.astro
// A reusable, anonymised "intelligence layer" case study card for AstroWind.
// Renders a tag, title, subtitle, an inline-SVG concept diagram, and two short
// beats (challenge + what changes). The diagram is one of two variants:
//   - "pipeline":  scattered expertise -> intelligence layer -> conversational access
//   - "synthesis": several underlying models -> decision-support layer -> guided judgement
//
// Colours use the standard Tailwind palette with dark: variants so it works out of
// the box. To match your AstroWind theme tokens, swap e.g. text-gray-900 -> text-default,
// bg-white -> bg-page, blue-* / teal-* -> your primary/accent scales.

export interface Props {
  tag: string;
  title: string;
  subtitle: string;
  challenge: string;
  whatChanges: string;
  variant?: 'pipeline' | 'synthesis';
}

const { tag, title, subtitle, challenge, whatChanges, variant = 'pipeline' } = Astro.props;

const pill =
  variant === 'synthesis'
    ? 'bg-teal-50 text-teal-700 dark:bg-teal-950 dark:text-teal-300'
    : 'bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300';

// Shared SVG text styles (caption labels under each stage)
const th = 'fill-gray-700 dark:fill-gray-200 text-[14px] font-medium';
const ts = 'fill-gray-500 dark:fill-gray-400 text-[12px]';
---

<article class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 sm:p-8">
  <span class={`inline-block rounded-md px-3 py-1 text-xs font-medium ${pill}`}>
    {tag}
  </span>
  <h3 class="mt-3 text-lg font-medium text-gray-900 dark:text-white">{title}</h3>
  <p class="text-sm text-gray-500 dark:text-gray-400">{subtitle}</p>

  {
    variant === 'pipeline' && (
      <svg class="my-5 w-full" viewBox="0 0 680 200" role="img" xmlns="http://www.w3.org/2000/svg">
        <title>Scattered expertise flows into an intelligence layer and out as conversational access</title>
        <desc>
          Disconnected documents, a structured live knowledge layer, and a search interface returning a trusted answer.
        </desc>
        <defs>
          <marker
            id="cs-arrow"
            viewBox="0 0 10 10"
            refX="8"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto-start-reverse"
          >
            <path
              d="M2 1L8 5L2 9"
              fill="none"
              stroke="context-stroke"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </marker>
        </defs>

        {/* Stage 1 — scattered expertise */}
        <rect class="fill-gray-300 dark:fill-slate-600" x="78" y="50" width="44" height="14" rx="3" opacity="0.9" />
        <rect class="fill-gray-300 dark:fill-slate-600" x="132" y="58" width="40" height="14" rx="3" opacity="0.5" />
        <rect class="fill-gray-300 dark:fill-slate-600" x="70" y="78" width="48" height="14" rx="3" opacity="0.7" />
        <rect class="fill-gray-300 dark:fill-slate-600" x="140" y="86" width="42" height="14" rx="3" opacity="0.45" />
        <rect class="fill-gray-300 dark:fill-slate-600" x="92" y="104" width="46" height="14" rx="3" opacity="0.8" />
        <rect class="fill-gray-300 dark:fill-slate-600" x="146" y="112" width="38" height="14" rx="3" opacity="0.4" />

        <line
          class="stroke-gray-400 dark:stroke-slate-500"
          x1="205"
          y1="90"
          x2="283"
          y2="90"
          stroke-width="1.5"
          marker-end="url(#cs-arrow)"
        />

        {/* Stage 2 — intelligence layer */}
        <rect
          class="fill-blue-50 stroke-blue-600 dark:fill-blue-950 dark:stroke-blue-400"
          x="290"
          y="46"
          width="128"
          height="88"
          rx="12"
          stroke-width="0.5"
        />
        <line class="stroke-blue-400" x1="312" y1="72" x2="354" y2="72" stroke-width="1" />
        <line class="stroke-blue-400" x1="354" y1="72" x2="396" y2="72" stroke-width="1" />
        <line class="stroke-blue-400" x1="312" y1="72" x2="354" y2="108" stroke-width="1" />
        <line class="stroke-blue-400" x1="396" y1="72" x2="354" y2="108" stroke-width="1" />
        <line class="stroke-blue-400" x1="312" y1="108" x2="354" y2="108" stroke-width="1" />
        <line class="stroke-blue-400" x1="354" y1="108" x2="396" y2="108" stroke-width="1" />
        <circle class="fill-blue-700 dark:fill-blue-300" cx="312" cy="72" r="5" />
        <circle class="fill-blue-700 dark:fill-blue-300" cx="354" cy="72" r="5" />
        <circle class="fill-blue-700 dark:fill-blue-300" cx="396" cy="72" r="5" />
        <circle class="fill-blue-700 dark:fill-blue-300" cx="312" cy="108" r="5" />
        <circle class="fill-blue-700 dark:fill-blue-300" cx="354" cy="108" r="5" />
        <circle class="fill-blue-700 dark:fill-blue-300" cx="396" cy="108" r="5" />
        <circle class="fill-teal-500" cx="406" cy="56" r="3" />

        <line
          class="stroke-gray-400 dark:stroke-slate-500"
          x1="421"
          y1="90"
          x2="497"
          y2="90"
          stroke-width="1.5"
          marker-end="url(#cs-arrow)"
        />

        {/* Stage 3 — conversational access */}
        <rect
          class="fill-gray-50 stroke-gray-300 dark:fill-slate-800 dark:stroke-slate-600"
          x="500"
          y="56"
          width="132"
          height="22"
          rx="11"
          stroke-width="0.5"
        />
        <circle class="fill-none stroke-gray-400 dark:stroke-slate-500" cx="514" cy="67" r="4" stroke-width="1" />
        <line
          class="stroke-gray-400 dark:stroke-slate-500"
          x1="517"
          y1="70"
          x2="521"
          y2="74"
          stroke-width="1"
          stroke-linecap="round"
        />
        <rect
          class="fill-teal-50 stroke-teal-600 dark:fill-teal-950 dark:stroke-teal-400"
          x="500"
          y="90"
          width="132"
          height="40"
          rx="8"
          stroke-width="0.5"
        />
        <rect class="fill-teal-700 dark:fill-teal-400" x="512" y="100" width="84" height="4" rx="2" opacity="0.85" />
        <rect class="fill-teal-700 dark:fill-teal-400" x="512" y="110" width="108" height="4" rx="2" opacity="0.5" />
        <rect class="fill-teal-700 dark:fill-teal-400" x="512" y="120" width="64" height="4" rx="2" opacity="0.5" />

        {/* Captions */}
        <text class={th} x="128" y="166" text-anchor="middle">
          Scattered expertise
        </text>
        <text class={ts} x="128" y="184" text-anchor="middle">
          hard to connect
        </text>
        <text class={th} x="354" y="166" text-anchor="middle">
          Intelligence layer
        </text>
        <text class={ts} x="354" y="184" text-anchor="middle">
          structured, current
        </text>
        <text class={th} x="566" y="166" text-anchor="middle">
          Conversational
        </text>
        <text class={ts} x="566" y="184" text-anchor="middle">
          ask, get the answer
        </text>
      </svg>
    )
  }

  {
    variant === 'synthesis' && (
      <svg class="my-5 w-full" viewBox="0 0 680 240" role="img" xmlns="http://www.w3.org/2000/svg">
        <title>
          Several underlying models converge into a decision-support layer feeding junior and senior judgement
        </title>
        <desc>
          Four labelled inputs flow into a central synthesis layer, which feeds two outputs: junior guidance and senior
          judgement.
        </desc>
        <defs>
          <marker
            id="cs-arrow2"
            viewBox="0 0 10 10"
            refX="8"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto-start-reverse"
          >
            <path
              d="M2 1L8 5L2 9"
              fill="none"
              stroke="context-stroke"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </marker>
        </defs>

        {/* Inputs — the underlying models */}
        <g>
          <rect
            class="fill-gray-100 stroke-gray-300 dark:fill-slate-800 dark:stroke-slate-600"
            x="44"
            y="38"
            width="140"
            height="32"
            rx="8"
            stroke-width="0.5"
          />
          <text
            class="fill-gray-600 dark:fill-gray-300 text-[12px]"
            x="114"
            y="54"
            text-anchor="middle"
            dominant-baseline="central"
          >
            Project history
          </text>
        </g>
        <g>
          <rect
            class="fill-gray-100 stroke-gray-300 dark:fill-slate-800 dark:stroke-slate-600"
            x="44"
            y="78"
            width="140"
            height="32"
            rx="8"
            stroke-width="0.5"
          />
          <text
            class="fill-gray-600 dark:fill-gray-300 text-[12px]"
            x="114"
            y="94"
            text-anchor="middle"
            dominant-baseline="central"
          >
            Benchmarking
          </text>
        </g>
        <g>
          <rect
            class="fill-gray-100 stroke-gray-300 dark:fill-slate-800 dark:stroke-slate-600"
            x="44"
            y="118"
            width="140"
            height="32"
            rx="8"
            stroke-width="0.5"
          />
          <text
            class="fill-gray-600 dark:fill-gray-300 text-[12px]"
            x="114"
            y="134"
            text-anchor="middle"
            dominant-baseline="central"
          >
            Live market data
          </text>
        </g>
        <g>
          <rect
            class="fill-gray-100 stroke-gray-300 dark:fill-slate-800 dark:stroke-slate-600"
            x="44"
            y="158"
            width="140"
            height="32"
            rx="8"
            stroke-width="0.5"
          />
          <text
            class="fill-gray-600 dark:fill-gray-300 text-[12px]"
            x="114"
            y="174"
            text-anchor="middle"
            dominant-baseline="central"
          >
            Financial models
          </text>
        </g>

        {/* Inputs -> layer */}
        <line class="stroke-teal-500" x1="186" y1="54" x2="286" y2="96" stroke-width="1" marker-end="url(#cs-arrow2)" />
        <line
          class="stroke-teal-500"
          x1="186"
          y1="94"
          x2="286"
          y2="108"
          stroke-width="1"
          marker-end="url(#cs-arrow2)"
        />
        <line
          class="stroke-teal-500"
          x1="186"
          y1="134"
          x2="286"
          y2="124"
          stroke-width="1"
          marker-end="url(#cs-arrow2)"
        />
        <line
          class="stroke-teal-500"
          x1="186"
          y1="174"
          x2="286"
          y2="136"
          stroke-width="1"
          marker-end="url(#cs-arrow2)"
        />

        {/* The decision-support layer (synthesis core) */}
        <rect
          class="fill-teal-50 stroke-teal-600 dark:fill-teal-950 dark:stroke-teal-400"
          x="288"
          y="78"
          width="126"
          height="68"
          rx="12"
          stroke-width="0.5"
        />
        <line class="stroke-teal-400" x1="302" y1="96" x2="392" y2="112" stroke-width="1" />
        <line class="stroke-teal-400" x1="302" y1="112" x2="392" y2="112" stroke-width="1" />
        <line class="stroke-teal-400" x1="302" y1="128" x2="392" y2="112" stroke-width="1" />
        <circle class="fill-teal-700 dark:fill-teal-400" cx="302" cy="96" r="3" />
        <circle class="fill-teal-700 dark:fill-teal-400" cx="302" cy="112" r="3" />
        <circle class="fill-teal-700 dark:fill-teal-400" cx="302" cy="128" r="3" />
        <circle class="fill-teal-700 dark:fill-teal-400" cx="392" cy="112" r="5" />

        {/* Layer -> outputs */}
        <line
          class="stroke-teal-500"
          x1="414"
          y1="104"
          x2="478"
          y2="98"
          stroke-width="1"
          marker-end="url(#cs-arrow2)"
        />
        <line
          class="stroke-teal-500"
          x1="414"
          y1="120"
          x2="478"
          y2="128"
          stroke-width="1"
          marker-end="url(#cs-arrow2)"
        />

        {/* Outputs — the two audiences */}
        <g>
          <rect
            class="fill-teal-50 stroke-teal-600 dark:fill-teal-950 dark:stroke-teal-400"
            x="480"
            y="82"
            width="150"
            height="30"
            rx="8"
            stroke-width="0.5"
          />
          <text
            class="fill-teal-800 dark:fill-teal-200 text-[12px]"
            x="555"
            y="97"
            text-anchor="middle"
            dominant-baseline="central"
          >
            Junior guidance
          </text>
        </g>
        <g>
          <rect
            class="fill-teal-50 stroke-teal-600 dark:fill-teal-950 dark:stroke-teal-400"
            x="480"
            y="120"
            width="150"
            height="30"
            rx="8"
            stroke-width="0.5"
          />
          <text
            class="fill-teal-800 dark:fill-teal-200 text-[12px]"
            x="555"
            y="135"
            text-anchor="middle"
            dominant-baseline="central"
          >
            Senior judgement
          </text>
        </g>

        {/* Captions */}
        <text class={th} x="114" y="210" text-anchor="middle">
          Underlying models
        </text>
        <text class={ts} x="114" y="228" text-anchor="middle">
          history, market, methods
        </text>
        <text class={th} x="351" y="210" text-anchor="middle">
          Decision-support layer
        </text>
        <text class={ts} x="351" y="228" text-anchor="middle">
          synthesises everything
        </text>
        <text class={th} x="555" y="210" text-anchor="middle">
          Guided judgement
        </text>
        <text class={ts} x="555" y="228" text-anchor="middle">
          faster, with depth
        </text>
      </svg>
    )
  }

  <div class="mt-2 grid gap-6 border-t border-gray-200 pt-4 dark:border-slate-700 sm:grid-cols-2">
    <div>
      <p class="mb-1.5 text-sm font-medium text-gray-500 dark:text-gray-400">The challenge</p>
      <p class="text-[15px] leading-relaxed text-gray-800 dark:text-gray-200">{challenge}</p>
    </div>
    <div>
      <p class="mb-1.5 text-sm font-medium text-gray-500 dark:text-gray-400">What changes</p>
      <p class="text-[15px] leading-relaxed text-gray-800 dark:text-gray-200">{whatChanges}</p>
    </div>
  </div>
</article>
