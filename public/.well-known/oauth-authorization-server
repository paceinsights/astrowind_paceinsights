{
  "issuer": "https://paceinsights.com",
  "authorization_endpoint": "https://paceinsights.com/oauth/authorize",
  "token_endpoint": "https://paceinsights.com/oauth/token",
  "jwks_uri": "https://paceinsights.com/oauth/jwks",
  "registration_endpoint": "https://paceinsights.com/oauth/register",
  "scopes_supported": [
    "api:read",
    "api:write"
  ],
  "response_types_supported": [
    "code",
    "token"
  ],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "urn:ietf:params:oauth:grant-type:token-exchange"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic",
    "private_key_jwt"
  ],
  "revocation_endpoint": "https://paceinsights.com/oauth/revoke",
  "agent_auth": {
    "skill": "https://paceinsights.com/auth.md",
    "register_uri": "https://paceinsights.com/api/agent/register",
    "revocation_uri": "https://paceinsights.com/api/agent/revoke",
    "events_supported": [
      "credential_revoked"
    ],
    "identity_types_supported": [
      "anonymous",
      "verified_email"
    ],
    "anonymous": {
      "credential_types_supported": [
        "api_key"
      ],
      "claim_uri": "https://paceinsights.com/api/agent/claim"
    },
    "verified_email": {
      "credential_types_supported": [
        "api_key"
      ],
      "claim_uri": "https://paceinsights.com/api/agent/claim",
      "identity_assertion": {
        "assertion_types_supported": [
          "verified_email"
        ]
      }
    }
  }
